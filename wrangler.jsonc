{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flogaus-aviation",
  "compatibility_date": "2026-04-12",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "compatibility_flags": ["nodejs_compat"]
}
