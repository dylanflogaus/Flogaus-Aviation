# Cal.com scheduling path or full URL (embedded on /booking by default).
# Examples:
#   VITE_CAL_LINK=dflogaus
#   VITE_CAL_LINK=dflogaus/discovery-call
#   VITE_CAL_LINK=https://cal.com/dflogaus/flight-review
#
# Per-lesson Cal.com paths (optional — defaults match dflogaus/* slugs on /booking):
#   VITE_CAL_INTRO_LINK=dflogaus/intro-flight
#   VITE_CAL_FLIGHT_LINK=dflogaus/flight-lesson
#   VITE_CAL_GROUND_LINK=dflogaus/ground-lesson
#
# Copy to .env and set your real value:
#   cp .env.example .env
#
# Online booking is scheduling only — no payment is collected on this site.

VITE_CAL_LINK=
VITE_CAL_INTRO_LINK=dflogaus/intro-flight
VITE_CAL_FLIGHT_LINK=dflogaus/flight-lesson
VITE_CAL_GROUND_LINK=dflogaus/ground-lesson
