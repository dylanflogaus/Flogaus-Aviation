# Cal.com scheduling path or full URL (embedded on /booking by default).
# Examples:
#   VITE_CAL_LINK=dflogaus
#   VITE_CAL_LINK=dflogaus/discovery-call
#   VITE_CAL_LINK=https://cal.com/dflogaus/flight-review
#
# Intro Flight embed (used for /booking?event=intro-flight and homepage CTAs):
#   VITE_CAL_INTRO_LINK=dflogaus/intro-flight
#
# Copy to .env and set your real value:
#   cp .env.example .env
#
# For paid sessions, connect Stripe in the Cal.com dashboard (Apps → Stripe).
# Do not put Stripe secret keys in this frontend project.

VITE_CAL_LINK=
VITE_CAL_INTRO_LINK=dflogaus/intro-flight
